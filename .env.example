# Copy this file to .env.local and fill in what you have.
# With no keys at all the app still runs in offline sample mode (no real AI).
# After adding a key, run `npm run check:ai` to test it.

# --- AI ----------------------------------------------------------------------
# Google Gemini key. Without it the app runs in sample mode.
GEMINI_API_KEY=
# GEMINI_MODEL=

# Force the provider: gemini | mock
# AI_PROVIDER=

# --- Database ----------------------------------------------------------------
# Leave empty for local development: an embedded PostgreSQL (PGlite) stores
# its data in .data/pglite.
# For deployment, paste the Supabase connection string (Project Settings ->
# Database -> Connection string -> Transaction pooler).
DATABASE_URL=
# Where the embedded database keeps its files. "memory" keeps nothing on disk.
# PGLITE_DIR=.data/pglite

# --- Demo --------------------------------------------------------------------
# The "Reset sample data" button on the first screen needs no sign-in and
# deletes everything in the sample class, including lessons made during a
# demo. Classes made by signing up are not touched. Set this to false
# on any site that other people can open (a hosted demo). The sample data is
# inserted on the first connection, so the reset is not needed for that.
# ALLOW_DEMO_RESET=false
